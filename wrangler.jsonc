// One Worker for the whole app: static assets for the pages, one Durable Object class for rooms.
// `pnpm dev` runs it inside Vite; a push to `main` deploys it through Cloudflare Workers Builds (see AGENTS.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tricks",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Any path that is not a file is the app (/, /thunee, /thunee/ABCDEF, ...).
    "not_found_handling": "single-page-application",
    // Room sockets go to the Worker before any asset lookup.
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    // routePartykitRequest names the URL segment after the binding: /parties/room/<game>-<CODE>.
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  // Applied in order, once each. v1 is the first in production. A change to the room classes
  // needs a new entry with a new tag; never edit or remove one that has been deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": {
    "enabled": true,
    // A socket's URL carries the device token, which owns a seat (?token=...). Logs and traces
    // must never hold it, so every URL they record loses its query string.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // One line per request and room message, with its outcome. Pages are served as assets
      // without running the Worker, so these are mostly room traffic.
      "invocation_logs": true
    }
  },
  // Cloudflare creates the DNS record for the custom domain on the first deploy. From CI, wrangler
  // replaces any record or Worker already on this hostname without asking: check before deploying.
  "routes": [{ "pattern": "tricks.afrojun.dev", "custom_domain": true }],
  // No <name>.workers.dev address and no per-version preview addresses: the custom domain only.
  "workers_dev": false,
  "preview_urls": false
}
