  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
